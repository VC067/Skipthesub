---
import Layout from '../layouts/Layout.astro';
import Newsletter from '../components/Newsletter.astro';
import { toolView, toolProfiles, PROFILES } from '../lib/data.js';
import toolsData from '../data/tools.json';

const views = toolsData.map(toolView);
const tools = views.map((view) => {
  const profiles = toolProfiles(view);
  const search = (view.name + ' ' + view.alternatives.map((a) => a.repo).join(' ')).toLowerCase();
  const profileData = PROFILES.map((profile) => {
    const stat = profiles.find((p) => p.id === profile.id);
    return {
      id: profile.id,
      fitCount: stat?.fitCount ?? 0,
      unverifiedCount: stat?.unverifiedCount ?? 0,
    };
  });
  const totalUnverified = profileData[0].unverifiedCount;
  return { view, search, profileData, totalUnverified };
});
---

<Layout title="SkipTheSub — open-source alternatives to paid AI tools">
  <section class="intro">
    <h1>Skip the sub.</h1>
    <p>Open-source alternatives to {tools.length} paid AI and SaaS tools — searchable and filterable by what your machine can run, with freshness data pulled weekly from the GitHub API.</p>
    <span class="tbd-note-inline">Anything without a sourced value shows as TBD and is never invented. Hardware data comes from project docs; see the <a href="/methodology/">methodology page</a> for the rubric.</span>
  </section>

  <section class="toolbar" aria-label="Search and filter">
    <label for="search">Search</label>
    <input id="search" type="search" placeholder="Search tools or repo names…" autocomplete="off" />
    <label for="hardware-filter">Runs on my machine</label>
    <select id="hardware-filter">
      <option value="">Any hardware</option>
      {PROFILES.map((p) => (
        <option value={p.id}>{p.label}</option>
      ))}
    </select>
  </section>

  <div id="unverified-banner" class="unverified-banner" hidden>
    Tools below have alternatives with no verified hardware data yet — they show an <strong>unverified</strong> count until someone fills in the specs from project docs.
  </div>

  <p id="results-note" class="results-note">Showing all {tools.length} tools</p>

  <section id="tool-list" class="tool-list" aria-label="Tool list">
    {
      tools.map(({ view, search, profileData, totalUnverified }) => {
        const total = view.alternatives.length;
        return (
          <article
            class="tool-card"
            data-search={search}
            data-profiles-key={JSON.stringify(profileData)}
          >
            <h2>
              <a href={`/alternatives/${view.slug}/`}>{view.name}</a>
            </h2>
            <p class="tool-meta">
              Monthly price: {view.price.value ?? 'TBD'}
              {view.price.urls.length > 0 && <> (<a href={view.price.urls[0]} rel="nofollow">source</a>)</>}
              {' · '}
              <a href={`/alternatives/${view.slug}/`}>
                {total} open-source alternative{total === 1 ? '' : 's'}
              </a>
            </p>
            <ul class="alt-chips">
              {view.alternatives.map((alt) => (
                <li>
                  <a href={`/alternatives/${view.slug}/#${alt.repo.replace('/', '--')}`}>{alt.repo}</a>
                </li>
              ))}
            </ul>
            <p class="card-profiles">
              {profileData.map((p) => (
                <span class="profile-chip" data-profile-chip={p.id}>
                  {p.fitCount} fit
                  {p.unverifiedCount > 0 ? ` · ${p.unverifiedCount} unverified` : ''}
                </span>
              ))}
            </p>
            {totalUnverified > 0 && (
              <p class="card-unverified" data-unverified>
                {totalUnverified} alternative{totalUnverified === 1 ? '' : 's'} with unverified hardware
              </p>
            )}
          </article>
        );
      })
    }
  </section>

  <Newsletter />
</Layout>

<script>
  const search = document.getElementById('search') as HTMLInputElement | null;
  const hwFilter = document.getElementById('hardware-filter') as HTMLSelectElement | null;
  const cards = [...document.querySelectorAll<HTMLElement>('.tool-card')];
  const resultsNote = document.getElementById('results-note');
  const unverifiedBanner = document.getElementById('unverified-banner');

  function apply() {
    if (!search || !hwFilter) return;
    const q = search.value.trim().toLowerCase();
    const hw = hwFilter.value;
    let shown = 0;
    let unverifiedShown = 0;

    for (const card of cards) {
      const text = card.dataset.search || '';
      let visible = true;

      if (q && !text.includes(q)) visible = false;

      let unverifiedForChip = 0;
      if (hw) {
        let stats: { fitCount: number; unverifiedCount: number } | undefined;
        try {
          stats = (JSON.parse(card.dataset.profilesKey || '[]') as { id: string; fitCount: number; unverifiedCount: number }[]).find(
            (p) => p.id === hw,
          );
        } catch {
          stats = undefined;
        }
        if (!stats || stats.fitCount === 0) visible = false;
        else unverifiedForChip = stats.unverifiedCount;
      }

      card.classList.toggle('is-unverified', visible && unverifiedForChip > 0);
      card.hidden = !visible;
      if (visible) {
        shown++;
        if (unverifiedForChip > 0) unverifiedShown++;
      }
    }

    if (resultsNote) {
      const filterText = hw ? ` for ${hwFilter.selectedOptions[0]?.textContent ?? hw}` : '';
      resultsNote.textContent = q || hw
        ? `${shown} of ${cards.length} tools shown${filterText}${unverifiedShown > 0 ? ` (${unverifiedShown} with unverified alternatives)` : ''}`
        : `Showing all ${cards.length} tools`;
    }
    if (unverifiedBanner) {
      unverifiedBanner.hidden = !(hw && unverifiedShown > 0);
    }
  }

  search?.addEventListener('input', apply);
  hwFilter?.addEventListener('change', apply);
  apply();
</script>
