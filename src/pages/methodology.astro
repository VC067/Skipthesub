---
import Layout from '../layouts/Layout.astro';
import Newsletter from '../components/Newsletter.astro';
import { sources, electricityInfo, vpsInfo, PROFILES } from '../lib/data.js';

const electricity = electricityInfo();
const vps = vpsInfo();
const rubric = sources.rubric ?? {};
---

<Layout
  title="Methodology — SkipTheSub"
  description="How SkipTheSub sources its data: the setup-difficulty rubric, running-cost formulas and inputs, hardware profiles, and the TBD policy."
>
  <section class="page-head">
    <p class="crumbs"><a href="/">SkipTheSub</a> / Methodology</p>
    <h1>Methodology</h1>
    <p>
      Every claim on this site carries a link to its source. Anything without one stays
      <strong>TBD</strong> and is never invented. This page lists the rubric, cost formulas and
      inputs behind the numbers.
    </p>
  </section>

  <section class="method-section">
    <h2>Setup difficulty rubric (1–5)</h2>
    <p>
      A rough measure of how much work it takes to go from zero to a working install of the
      alternative. Shown on tool pages as “N/5” with the matching rubric text.
    </p>
    <ol class="rubric-list">
      {Object.entries(rubric).map(([level, text]) => (
        <li>
          <strong>{level}/5</strong> — {text}
        </li>
      ))}
    </ol>
  </section>

  <section class="method-section">
    <h2>Running cost: VPS</h2>
    <p>{vps.formula ?? 'TBD'}</p>
    {vps.source && (
      <p>
        Plan prices: <a href={vps.source} rel="nofollow">{vps.source}</a>
      </p>
    )}
    {vps.plans.length > 0 && (
      <table class="plans-table">
        <thead>
          <tr><th>Plan RAM</th><th>Price</th></tr>
        </thead>
        <tbody>
          {vps.plans.map((plan) => (
            <tr><td>{plan.ramGB} GB</td><td>${plan.usd}/mo</td></tr>
          ))}
        </tbody>
      </table>
    )}
  </section>

  <section class="method-section">
    <h2>Running cost: local electricity</h2>
    <p><code>{electricity.formula ?? 'TBD'}</code></p>
    <p>
      Rate: {electricity.rate ?? 'TBD'} $/kWh
      (
      {electricity.source ? <a href={electricity.source} rel="nofollow">EIA source</a> : 'source TBD'}
      {electricity.note ? ` — ${electricity.note}` : ''}
      ).
    </p>
    <p>The calculator on each alternative's page is client-side only: enter watts and hours/day, and it applies this formula in your browser. Fields start empty.</p>
  </section>

  <section class="method-section">
    <h2>“Runs on my machine” profiles</h2>
    <p>
      The index filter matches each alternative's sourced minimum hardware against one of these
      profiles. An alternative with no verified hardware data never counts as fitting — it shows
      as “unverified” instead.
    </p>
    <ul>
      {PROFILES.map((profile) => (
        <li><strong>{profile.label}</strong> — {profile.hint}</li>
      ))}
    </ul>
    <ul>
      <li><strong>cpu</strong>: <code>runsOn</code> includes “cpu” and (RAM TBD or ≤ 16 GB)</li>
      <li><strong>mac16</strong>: <code>runsOn</code> includes “mac” or “cpu”, and (RAM TBD or ≤ 16 GB)</li>
      <li><strong>gpuN</strong> (N = 8/12/24): <code>runsOn</code> includes “cpu”, or (<code>runsOn</code> includes “gpu” and VRAM is a number ≤ N GB)</li>
    </ul>
  </section>

  <section class="method-section">
    <h2>Where the data lives</h2>
    <ul>
      <li><code>src/data/tools.json</code> — the tool/alternative catalogue (content values are not edited by hand here).</li>
      <li><code>src/data/sources.json</code> — every sourced fact: prices, can/can't-do, minimum hardware, setup difficulty, rubric, cost inputs. Merged over the catalogue at build time.</li>
      <li><code>src/data/freshness.json</code> — GitHub stars/pushes/releases, refreshed weekly by a scheduled job.</li>
    </ul>
  </section>

  <Newsletter />
</Layout>
