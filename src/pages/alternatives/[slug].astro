---
import Layout from '../../layouts/Layout.astro';
import BadgeSnippet from '../../components/BadgeSnippet.astro';
import Newsletter from '../../components/Newsletter.astro';
import { dateShort, formatStars } from '../../lib/format.js';
import { toolView, electricityInfo, vpsInfo, vpsCost } from '../../lib/data.js';
import fs from 'node:fs';
import path from 'node:path';
import tools from '../../data/tools.json';

function loadFreshness() {
  try {
    const file = path.resolve(process.cwd(), 'src', 'data', 'freshness.json');
    return JSON.parse(fs.readFileSync(file, 'utf8'));
  } catch {
    return {};
  }
}
const freshness = loadFreshness();
const electricity = electricityInfo();

export function getStaticPaths() {
  return tools.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props;
const view = toolView(tool);
const price = view.price;
const priceUrls = price.urls;
---

<Layout
  title={`${tool.name} alternatives — SkipTheSub`}
  description={`Open-source alternatives to ${tool.name}, with sourced capability, hardware, setup difficulty and running-cost data plus GitHub freshness. Run it yourself and skip the sub.`}
>
  <section class="page-head">
    <p class="crumbs"><a href="/">SkipTheSub</a> / {tool.name}</p>
    <h1>Open-source alternatives to {tool.name}</h1>
    <p>
      Monthly price for {tool.name}:
      {price.value ? (
        <>
          <strong>{price.value}</strong>
          {priceUrls.map((url, i) => (
            <> (<a href={url} rel="nofollow">source{priceUrls.length > 1 ? ` ${i + 1}` : ''}</a>)</>
          ))}
        </>
      ) : (
        <strong class="tbd-inline">TBD</strong>
      )}
      {!price.value && ' (unverified — never invented)'}. Below: {view.alternatives.length} open-source alternative{view.alternatives.length === 1 ? '' : 's'}.
    </p>
  </section>

  <section class="alt-section" aria-label={`Alternatives to ${tool.name}`}>
    {
      view.alternatives.map((alt) => {
        const fresh = freshness[alt.repo];
        const mh = alt.minHardware;
        const setup = alt.setupDifficulty;
        const vps = vpsCost(mh);
        const vpsInfoData = vpsInfo();
        const altId = alt.repo.replace('/', '--');
        return (
          <article class="alt-card" id={altId}>
            <h2>
              <a href={alt.githubUrl} rel="me nofollow">{alt.repo}</a>
              {fresh?.archived && <span class="archived-warning">Archived repo</span>}
            </h2>

            <div class="alt-grid">
              <div class="fact">
                <h3>What it can do</h3>
                {alt.canDo ? (
                  <p>{alt.canDo.value}{alt.canDo.note ? ` (${alt.canDo.note})` : ''}{alt.canDo.source && <> <a class="src-link" href={alt.canDo.source} rel="nofollow">source</a></>}</p>
                ) : (
                  <p class="tbd">TBD</p>
                )}
              </div>
              <div class="fact">
                <h3>What it can't do</h3>
                {alt.cantDo ? (
                  <p>{alt.cantDo.value}{alt.cantDo.note ? ` (${alt.cantDo.note})` : ''}{alt.cantDo.source && <> <a class="src-link" href={alt.cantDo.source} rel="nofollow">source</a></>}</p>
                ) : (
                  <p class="tbd">TBD</p>
                )}
              </div>
              <div class="fact">
                <h3>Minimum hardware</h3>
                {mh.hasData ? (
                  <dl>
                    <dt>RAM</dt>
                    <dd>{mh.ramGB !== null ? `${mh.ramGB} GB` : <span class="tbd">TBD</span>}</dd>
                    <dt>VRAM</dt>
                    <dd>{mh.vramGB !== null ? `${mh.vramGB} GB` : <span class="tbd">TBD</span>}</dd>
                    <dt>Runs on</dt>
                    <dd>
                      {mh.runsOn.length > 0 ? (
                        <ul>{mh.runsOn.map((r) => <li>{r}</li>)}</ul>
                      ) : (
                        <span class="tbd">TBD</span>
                      )}
                    </dd>
                    {mh.note && <><dt>Note</dt><dd>{mh.note}</dd></>}
                  </dl>
                ) : (
                  <p class="tbd">TBD</p>
                )}
                {mh.source && <a class="src-link" href={mh.source} rel="nofollow">source</a>}
              </div>
              <div class="fact">
                <h3>Setup difficulty</h3>
                {setup ? (
                  <p>
                    <strong>{setup.value}/5</strong> — {setup.rubric ?? 'see rubric'}
                    {setup.source && <> <a class="src-link" href={setup.source} rel="nofollow">source</a></>}
                  </p>
                ) : (
                  <p class="tbd">TBD</p>
                )}
              </div>
              <div class="fact">
                <h3>Freshness</h3>
                {fresh ? (
                  <dl>
                    <dt>Stars</dt><dd>{formatStars(fresh.stars) ?? 'not fetched yet'}</dd>
                    <dt>Last push</dt><dd>{dateShort(fresh.pushedAt) ?? 'not fetched yet'}</dd>
                    <dt>Latest release</dt>
                    <dd>
                      {fresh.latestRelease ? (
                        fresh.latestRelease.url ? (
                          <a href={fresh.latestRelease.url} rel="nofollow">{fresh.latestRelease.tagName ?? 'view release'}</a>
                        ) : (
                          fresh.latestRelease.tagName ?? 'view release'
                        )
                      ) : (
                        'no releases'
                      )}
                    </dd>
                  </dl>
                ) : (
                  <p class="tbd">not fetched yet</p>
                )}
              </div>
            </div>

            <div class="running-cost" data-cost>
              <h3>Running cost (per month, roughly)</h3>
              {vps.reason === 'gpu-only' ? (
                <p class="vps-cost">VPS: <span class="tbd">TBD</span> — needs a GPU host, not covered by plain VPS plans</p>
              ) : vps.reason === 'ram-unknown' ? (
                <p class="vps-cost">VPS: <span class="tbd">TBD</span> — minimum RAM not verified</p>
              ) : vps.reason === 'no-plan' ? (
                <p class="vps-cost">VPS: <span class="tbd">TBD</span> — listed plans don't cover this much RAM</p>
              ) : (
                <p class="vps-cost">
                  VPS: <strong>${vps.value}/mo</strong> (assumes DigitalOcean Basic Droplet with {vps.ramGB} GB RAM)
                  {vpsInfoData.source && <> <a class="src-link" href={vpsInfoData.source} rel="nofollow">source</a></>}
                </p>
              )}
              <p class="local-cost">
                Local electricity: <span data-cost-local>$ —/mo</span>
                <span class="cost-formula">
                  watts / 1000 × hours/day × 30 × {electricity.rate ?? 'TBD'} $/kWh
                  {electricity.source && <> <a class="src-link" href={electricity.source} rel="nofollow">source</a></>}
                </span>
              </p>
              <form class="cost-calc" data-cost-calc>
                <label for={`watts-${altId}`}>Watts</label>
                <input id={`watts-${altId}`} type="number" min="0" step="1" name={`watts-${altId}`} placeholder="watts" data-input-watts />
                <label for={`hours-${altId}`}>Hours/day</label>
                <input id={`hours-${altId}`} type="number" min="0" step="0.25" name={`hours-${altId}`} placeholder="hours/day" data-input-hours />
              </form>
            </div>

            {fresh && (
              <p class="freshness-note">Fetched {dateShort(fresh.fetchedAt)} from the GitHub API.</p>
            )}

            <p class="alt-actions">
              <a class="btn" href={alt.githubUrl} rel="nofollow">Open on GitHub</a>
            </p>
          </article>
        );
      })
    }
  </section>

  <BadgeSnippet slug={tool.slug} />
  <Newsletter />
</Layout>

<script>
  import { electricityUsdPerKwh } from '../../lib/cost-constants.js';

  const calc = document.querySelectorAll('[data-cost-calc]');
  calc.forEach((root) => {
    if (!(root instanceof HTMLElement)) return;
    const wattsInput = root.querySelector('[data-input-watts]') as HTMLInputElement | null;
    const hoursInput = root.querySelector('[data-input-hours]') as HTMLInputElement | null;
    const out = root.parentElement?.querySelector('[data-cost-local]');
    if (!wattsInput || !hoursInput || !out) return;
    const update = () => {
      const watts = Number.parseFloat(wattsInput.value);
      const hours = Number.parseFloat(hoursInput.value);
      const monthly =
        Number.isFinite(watts) && Number.isFinite(hours) && watts >= 0 && hours >= 0
          ? (watts / 1000) * hours * 30 * electricityUsdPerKwh
          : null;
      out.textContent = monthly !== null ? `$${monthly.toFixed(2)}/mo` : 'enter watts & hours/day';
    };
    wattsInput.addEventListener('input', update);
    hoursInput.addEventListener('input', update);
    update();
  });
</script>
