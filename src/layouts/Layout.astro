---
import '../styles/global.css';

const {
  title = 'SkipTheSub — open-source alternatives to paid AI tools',
  description = 'SkipTheSub lists open-source alternatives to paid AI and SaaS tools, so you can skip the sub and run it yourself.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href="/">Skip<span>TheSub</span></a>
        <span class="tagline">Open-source alternatives to paid AI tools</span>
        <nav class="site-nav">
          <a href="/">Tools</a>
          <a href="/methodology/">Methodology</a>
        </nav>
      </div>
    </header>
    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p>
          Data is pulled from public GitHub APIs. Facts carry source links; anything unverified shows as TBD, never invented.
          See <a href="/methodology/">the methodology</a> for the setup rubric and cost formulas.
        </p>
      </div>
    </footer>
  </body>
</html>
