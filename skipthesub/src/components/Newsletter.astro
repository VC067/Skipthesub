---
---

<div class="newsletter">
  <h2>Stay in the loop</h2>
  <p>Get a heads-up when new tools and verified facts (hardware, setup difficulty) land in the directory.</p>
  <form action="#" method="post">
    <label class="visually-hidden" for="newsletter-email">Email address</label>
    <input id="newsletter-email" type="email" name="email" required placeholder="you@example.com" />
    <button class="btn" type="submit">Sign up</button>
  </form>
  <p class="soon">Newsletter coming soon. No list, no service, no spam — this form is a placeholder.</p>
</div>

<style>
  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  document.querySelectorAll('.newsletter form').forEach((form) => {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      window.alert('Newsletter coming soon — no signup yet.');
    });
  });
</script>
